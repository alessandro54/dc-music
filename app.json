{
    "name": "music-bot",
    "description": "Personal Discord music bot",
    "healthchecks": {
        "web": [
            {
                "type": "startup",
                "name": "connected to Discord",
                "description": "GET /health — 200 once the gateway client is ready, 503 while connecting",
                "path": "/health",
                "port": 3000,
                "attempts": 12,
                "wait": 5,
                "timeout": 5
            }
        ]
    },
    "scripts": {
        "dokku": {
            "postdeploy": "deno run --allow-all --cached-only src/deployCommands.js"
        }
    }
}
