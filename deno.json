{
  "nodeModulesDir": "auto",
  "fmt": {
    "indentWidth": 4,
    "lineWidth": 110,
    "include": ["src/", "tests/", "scripts/", "drizzle.config.js"],
    "exclude": ["src/db/migrations/"]
  },
  "lint": {
    "include": ["src/", "tests/", "scripts/"],
    "plugins": ["./scripts/lint/sort-imports.js"],
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "imports": {
    "@/": "./src/",
    "@discordjs/voice": "npm:@discordjs/voice@^0.19.2",
    "@libsql/client": "npm:@libsql/client@^0.15.15",
    "@libsql/client/web": "npm:@libsql/client@^0.15.15/web",
    "drizzle-orm": "npm:drizzle-orm@^0.44.7",
    "drizzle-orm/libsql": "npm:drizzle-orm@^0.44.7/libsql",
    "drizzle-orm/libsql/migrator": "npm:drizzle-orm@^0.44.7/libsql/migrator",
    "drizzle-orm/sqlite-core": "npm:drizzle-orm@^0.44.7/sqlite-core",
    "@sentry/deno": "npm:@sentry/deno@^10.70.0",
    "discord.js": "npm:discord.js@^14.27.0",
    "opusscript": "npm:opusscript@^0.1.1",
    "pngjs": "npm:pngjs@^7.0.0",
    "youtubei.js": "npm:youtubei.js@^18.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "start": "deno run --allow-all --env-file=.env src/index.js",
    "dev": "deno run --allow-all --env-file=.env --watch src/index.js",
    "deploy": "deno run --allow-all --env-file=.env src/deployCommands.js",
    "spotify-auth": "deno run --allow-net --allow-env --env-file=.env scripts/spotify-auth.js",
    "test": "deno test --allow-all tests/music/ tests/pokemon/",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "check": "deno fmt --check && deno lint && deno check src/index.js",
    "db:generate": "deno run -A npm:drizzle-kit@^0.31.0 generate"
  }
}
